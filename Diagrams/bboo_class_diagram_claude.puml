@startuml BbooSystemClassDiagram

!theme plain
skinparam backgroundColor #FAFAFA
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #444444
skinparam classFontSize 13
skinparam classAttributeFontSize 11
skinparam classStereotypeFontSize 10
skinparam ArrowColor #333333
skinparam ArrowThickness 1.5
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80
skinparam packageBackgroundColor #F0F4FF
skinparam packageBorderColor #5566AA
skinparam packageFontSize 14
skinparam packageFontStyle bold

' =====================================================================
' PACKAGE: API LAYER
' =====================================================================
package "API Layer" <<Frame>> {

  class FastAPIApp <<entrypoint>> {
    + title : str
    + version : str
    --
    ' UI Page Routes
    + root() : FileResponse
    + dashboard_page() : FileResponse
    + assistant_page() : FileResponse
    + usage_page() : FileResponse
    + profile_page() : FileResponse
    + summary_page() : FileResponse
    + checkins_page() : FileResponse
    + plan_page() : FileResponse
    + insights_page() : FileResponse
    ' Static Assets
    + styles_asset() : FileResponse
    + dashboard_script() : FileResponse
    + auth_script() : FileResponse
    + icon_asset() : FileResponse
    ' Auth APIs
    + register(payload) : JSONResponse
    + login(payload) : dict
    + logout(authorization) : dict
    + logout_all_devices(authorization) : dict
    ' Profile APIs
    + get_profile(authorization) : dict
    + update_profile(payload, authorization) : dict
    ' Dashboard & Plans
    + get_dashboard(lang, mode, authorization) : dict
    + get_plan(lang, authorization) : dict
    + save_plan(payload, authorization) : dict
    + get_plan_history(authorization) : dict
    + get_weekly_summary(authorization) : dict
    ' Settings
    + get_settings(authorization) : dict
    + update_settings(payload, authorization) : dict
    ' Checkins & Timers
    + get_checkins(authorization) : dict
    + record_checkin(payload, authorization) : dict
    + get_timers(authorization) : dict
    + start_timer(payload, authorization) : dict
    + complete_timer(payload, authorization) : dict
    ' App Usage
    + get_app_usage(authorization) : dict
    + get_app_usage_detail(app, authorization) : dict
    + save_app_usage(payload, authorization) : dict
    ' Guardian System
    + get_children(authorization) : dict
    + guardian_link(payload, authorization) : dict
    ' AI Agent
    + agent_chat(payload, authorization) : dict
    + agent_history(authorization) : dict
    ' System
    + health() : dict
    --
    ' Helper functions
    + require_session(authorization) : dict
    + optional_token(authorization) : str
    + validate_registration_payload(payload) : None
    + ensure_required(payload, fields) : None
    + profile_payload(session) : dict
  }

  class LegacyHTTPServer <<entrypoint>> {
    + host : str
    + port : int
    --
    + do_GET() : None
    + do_POST() : None
    + do_PUT() : None
    + end_headers() : None
    ' Route Handlers
    + _handle_dashboard() : None
    + _handle_plan() : None
    + _handle_profile() : None
    + _handle_settings() : None
    + _handle_checkins() : None
    + _handle_timers() : None
    + _handle_app_usage() : None
    + _handle_register() : None
    + _handle_login() : None
    + _handle_logout() : None
    + _handle_agent_chat() : None
    + _handle_agent_history() : None
    ' Utils
    + _build_dashboard_payload() : dict
    + _read_json() : dict
    + _single() : Any
    + _bearer_token() : str
    + _send_json() : None
    + load_dotenv() : None
    + parse_args() : Namespace
    + main() : None
  }
}

' =====================================================================
' PACKAGE: SERVICE LAYER
' =====================================================================
package "Service Layer" <<Frame>> {

  class BbooAppService {
    - repository : MySQLRepository
    - simulator : BehaviorSimulator
    - focus_engine : FocusEngine
    --
    + dashboard_payload(session, lang, mode) : dict
    + plan_payload(session, lang) : dict
    + update_setting_field(user_id, key, value) : dict
  }
}

' =====================================================================
' PACKAGE: AGENT LAYER
' =====================================================================
package "Agent Layer" <<Frame>> {

  class LocalLangGraphAgent {
    - service : BbooAppService
    - rag : LocalChromaStore
    - embedder : SimpleEmbeddingModel
    - ollama : OllamaClient
    - tools : BbooToolRegistry
    --
    + run(message, session, settings) : dict
    - _retrieve_context(message) : str
    - _plan(message, context, session, settings) : dict
    - _select_tool(intent, args) : str
    - _execute_tool(tool_name, args, session, settings) : dict
  }

  class AssistantEngine <<legacy>> {
    - service : BbooAppService
    - rag : LocalChromaStore
    --
    + handle_message(message, session, settings) : dict
    + retrieve_context(message) : str
    + to_dict() : dict
  }

  class BbooToolRegistry {
    - service : BbooAppService
    - repository : MySQLRepository
    --
    + get_dashboard_summary(session, settings) : dict
    + get_weekly_summary(user_id) : dict
    + get_suggestions(user_id, settings) : dict
    + get_app_usage_summary(user_id) : dict
    + update_session_minutes(user_id, minutes) : dict
    + update_app_name(user_id, name) : dict
    + update_bedtime_target(user_id, time) : dict
    + update_sleep_target_hours(user_id, hours) : dict
    + start_focus_timer(user_id, minutes, label) : dict
    + stop_focus_timer(user_id) : dict
    - _dashboard_summary(session, settings) : dict
    - _weekly_summary(user_id) : dict
    - _suggestions(user_id, settings) : dict
    - _start_focus_timer(user_id, minutes, label) : dict
  }
}

' =====================================================================
' PACKAGE: LLM / RETRIEVAL LAYER
' =====================================================================
package "LLM & Retrieval Layer" <<Frame>> {

  class OllamaClient {
    - endpoint : str
    - model : str
    --
    + plan(message, context, session, settings) : dict
  }

  class LocalChromaStore {
    - documents : list
    - embedder : SimpleEmbeddingModel
    --
    + query(text, top_k) : list
  }

  class SimpleEmbeddingModel {
    - idf : dict
    --
    + embed(text) : dict
    + similarity(vec_a, vec_b) : float
    + build_idf(corpus) : None
    + tfidf_vector(text) : dict
  }
}

' =====================================================================
' PACKAGE: FOCUS ENGINE LAYER
' =====================================================================
package "Focus Engine Layer" <<Frame>> {

  class FocusEngine {
    --
    + build_dashboard(profile, usage, checkins, timers) : DashboardSnapshot
    + build_personalized_plan(profile, score, settings) : FocusPlan
    - _focus_score(usage, checkins, timers) : float
    - _metrics(score, profile) : list
    - _habits(score, profile) : list
    - _insights(score, profile) : list
    - _charts(usage, checkins) : list
  }
}

' =====================================================================
' PACKAGE: SIMULATOR LAYER
' =====================================================================
package "Simulator Layer" <<Frame>> {

  class BehaviorSimulator {
    --
    + __init__() : None
    + build_profile(audience, permissions_granted, first_name,\n  last_name, email, country, preferred_language, role) : UserProfile
  }
}

' =====================================================================
' PACKAGE: REPOSITORY LAYER
' =====================================================================
package "Repository Layer" <<Frame>> {

  class MySQLConfig {
    + host : str
    + port : int
    + database : str
    + user : str
    + password : str
  }

  class MySQLRepository {
    - config : MySQLConfig
    --
    + initialize() : None
    ' Auth
    + create_user(payload, profile) : dict
    + authenticate_user(email, password, language) : dict
    + load_session(token) : dict
    + delete_session(token) : None
    + delete_other_sessions(user_id, token) : None
    ' Profile
    + load_profile_by_user_id(user_id) : UserProfile
    + update_profile(user_id, payload) : dict
    ' Settings
    + load_settings(user_id) : dict
    + update_settings(user_id, payload) : dict
    ' Plans
    + save_focus_plan(user_id, plan) : FocusPlan
    + load_plan_history(user_id) : list
    ' Checkins
    + record_checkin(user_id, mood, energy, notes) : None
    + recent_checkins(user_id) : list
    ' Timers
    + start_focus_timer(user_id, minutes, label) : None
    + complete_focus_timer(user_id, timer_id, completed) : None
    + active_timer(user_id) : dict
    + recent_timers(user_id) : list
    ' App Usage
    + save_app_usage(user_id, app_name, usage_date, usage_hours) : None
    + app_usage_summary(user_id) : list
    + app_usage_detail(user_id, app_name) : list
    ' Analytics
    + weekly_summary(user_id) : dict
    + app_usage_summary(user_id) : list
    + live_behavior_signals(user_id) : dict
    + suggestion_engine(user_id, settings) : list
    ' Dashboard Snapshots
    + save_dashboard_snapshot(user_id, score) : None
    ' Guardian
    + link_child_account(user_id, child_email) : None
    + linked_children(user_id) : list
    ' Agent Memory
    + ensure_agent_conversation(user_id) : int
    + record_agent_message(conversation_id, role, content, intent, tool_name) : None
    + record_agent_action(user_id, conversation_id, tool_name,\n  status, input_payload, output_payload) : None
    + agent_history(user_id) : list
  }
}

' =====================================================================
' PACKAGE: DOMAIN MODEL LAYER (shared/schemas.py)
' =====================================================================
package "Domain Model Layer" <<Frame>> {

  class AccountProfile {
    + first_name : str
    + last_name : str
    + email : str
    + country : str
    + preferred_language : str
    + role : str
  }

  class UserProfile {
    + account : AccountProfile
    + permissions_granted : bool
    + audience : str
    --
    + to_dict() : dict
  }

  class FocusMetric {
    + label : str
    + value : Any
    + unit : str
    + trend : str
    --
    + to_dict() : dict
  }

  class HabitCard {
    + title : str
    + description : str
    + frequency : str
    + icon : str
    --
    + to_dict() : dict
  }

  class InsightCard {
    + title : str
    + body : str
    + severity : str
    --
    + to_dict() : dict
  }

  class ParentGuidance {
    + title : str
    + body : str
    --
    + to_dict() : dict
  }

  class ProfileField {
    + key : str
    + label : str
    + value : Any
    --
    + to_dict() : dict
  }

  class TrendPoint {
    + date : str
    + value : float
    --
    + to_dict() : dict
  }

  class ChartSeries {
    + label : str
    + points : list[TrendPoint]
    --
    + to_dict() : dict
  }

  class DashboardSnapshot {
    + focus_score : float
    + brain_state : str
    + metrics : list[FocusMetric]
    + habits : list[HabitCard]
    + insights : list[InsightCard]
    + charts : list[ChartSeries]
    + parent_guidance : list[ParentGuidance]
    --
    + to_dict() : dict
  }

  class FocusPlan {
    + generated_at : str
    + title : str
    + recommended_session_minutes : int
    + focus_theme : str
    + steps : list[str]
    + attention_game : str
    --
    + to_dict() : dict
  }
}

' =====================================================================
' RELATIONSHIPS — API Layer
' =====================================================================
FastAPIApp  --> BbooAppService        : uses >
FastAPIApp  --> MySQLRepository       : uses >
FastAPIApp  --> LocalLangGraphAgent   : uses >
LegacyHTTPServer --> BbooAppService   : uses >
LegacyHTTPServer --> MySQLRepository  : uses >
LegacyHTTPServer --> LocalLangGraphAgent : uses >

' =====================================================================
' RELATIONSHIPS — Service Layer
' =====================================================================
BbooAppService --> MySQLRepository    : uses >
BbooAppService --> BehaviorSimulator  : uses >
BbooAppService --> FocusEngine        : uses >

' =====================================================================
' RELATIONSHIPS — Agent Layer
' =====================================================================
LocalLangGraphAgent --> BbooAppService     : uses >
LocalLangGraphAgent --> LocalChromaStore   : queries >
LocalLangGraphAgent --> SimpleEmbeddingModel : uses >
LocalLangGraphAgent --> OllamaClient       : plans with >
LocalLangGraphAgent --> BbooToolRegistry   : executes >
AssistantEngine --> BbooAppService         : uses >
AssistantEngine --> LocalChromaStore       : queries >
BbooToolRegistry --> BbooAppService        : calls >
BbooToolRegistry --> MySQLRepository       : calls >

' =====================================================================
' RELATIONSHIPS — LLM / Retrieval Layer
' =====================================================================
LocalChromaStore --> SimpleEmbeddingModel  : uses >

' =====================================================================
' RELATIONSHIPS — Focus Engine
' =====================================================================
FocusEngine --> DashboardSnapshot : builds >
FocusEngine --> FocusPlan         : builds >
FocusEngine --> FocusMetric       : creates >
FocusEngine --> HabitCard         : creates >
FocusEngine --> InsightCard       : creates >
FocusEngine --> ChartSeries       : creates >

' =====================================================================
' RELATIONSHIPS — Simulator
' =====================================================================
BehaviorSimulator --> UserProfile     : builds >
BehaviorSimulator --> AccountProfile  : creates >

' =====================================================================
' RELATIONSHIPS — Repository
' =====================================================================
MySQLRepository --> MySQLConfig     : configured by >
MySQLRepository --> UserProfile     : loads >
MySQLRepository --> FocusPlan       : saves / loads >

' =====================================================================
' RELATIONSHIPS — Domain Model
' =====================================================================
UserProfile       *-- AccountProfile   : contains
DashboardSnapshot *-- FocusMetric      : contains
DashboardSnapshot *-- HabitCard        : contains
DashboardSnapshot *-- InsightCard      : contains
DashboardSnapshot *-- ChartSeries      : contains
DashboardSnapshot *-- ParentGuidance   : contains
ChartSeries       *-- TrendPoint       : contains

@enduml
